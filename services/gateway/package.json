{
  "name": "@aura/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint src test --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude test/identity-persistence.test.ts",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "identity:bootstrap-dev-user": "tsx src/identity/bootstrap-dev-user.ts",
    "identity:dev-session": "tsx src/identity/create-dev-session.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/helmet": "13.1.0",
    "@fastify/multipart": "9.3.0",
    "@fastify/websocket": "11.2.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "5.11.3",
    "jose": "6.2.8",
    "openid-client": "6.8.5",
    "pg": "^8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.2.0",
    "@types/pg": "^8.21.0",
    "@types/ws": "8.18.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.5",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "ws": "8.18.3"
  }
}
