{
  "name": "aura",
  "version": "0.0.0",
  "private": true,
  "description": "AURA — Self-Hosted Multilingual Autonomous Voice Agent",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build && pnpm run agent:build",
    "lint": "turbo run lint && pnpm run agent:lint",
    "typecheck": "turbo run typecheck && pnpm run agent:typecheck",
    "test": "turbo run test && pnpm run agent:test",
    "format": "prettier --write . && pnpm run agent:format",
    "format:check": "prettier --check . && pnpm run agent:format:check",
    "agent:build": "node scripts/run-agent-python.mjs -m compileall -q services/agent/src",
    "agent:lint": "node scripts/run-agent-python.mjs -m ruff check services/agent",
    "agent:typecheck": "node scripts/run-agent-python.mjs -m pyright -p services/agent/pyproject.toml",
    "agent:test": "node scripts/run-agent-python.mjs -m pytest services/agent",
    "agent:format": "node scripts/run-agent-python.mjs -m ruff format services/agent",
    "agent:format:check": "node scripts/run-agent-python.mjs -m ruff format --check services/agent",
    "db:generate": "pnpm --filter @aura/gateway db:generate",
    "db:migrate": "pnpm --filter @aura/gateway db:migrate",
    "identity:bootstrap-dev-user": "pnpm --filter @aura/gateway identity:bootstrap-dev-user",
    "identity:dev-session": "pnpm --filter @aura/gateway identity:dev-session"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "prettier": "^3.9.6",
    "turbo": "^2.10.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
