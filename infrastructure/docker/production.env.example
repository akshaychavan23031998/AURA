# Copy outside source control or to an ignored .env file and replace every value.
AURA_DOMAIN=localhost
AURA_PUBLIC_ORIGIN=https://localhost:8443
AURA_HTTP_PORT=8080
AURA_HTTPS_PORT=8443

POSTGRES_DB=aura
POSTGRES_USER=aura
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_QUERY_TIMEOUT_MS=10000
MEMORY_EMBEDDINGS_ENABLED=false
MEMORY_EMBEDDING_BASE_URL=
MEMORY_EMBEDDING_MODEL=
MEMORY_EMBEDDING_DIMENSIONS=384
MEMORY_EMBEDDING_TIMEOUT_MS=5000
MEMORY_SEARCH_LIMIT=5
MEMORY_SEARCH_MIN_SIMILARITY=0.5
KNOWLEDGE_SEARCH_LIMIT=5
KNOWLEDGE_SEARCH_MIN_SIMILARITY=0.5

TOOLS_SERVICE_TOKEN=replace-with-a-distinct-random-token-at-least-32-characters
AGENT_SERVICE_TOKEN=replace-with-a-distinct-random-token-at-least-32-characters
VOICE_SERVICE_TOKEN=replace-with-a-distinct-random-token-at-least-32-characters
AUTH_JWT_SECRET=replace-with-a-distinct-high-entropy-secret-at-least-32-characters

# Absolute host directory containing faster-whisper-tiny and Piper .onnx/.json files.
VOICE_MODEL_PATH=/absolute/path/to/aura/models/voice

# Deterministic mode validates deployment without starting llama.cpp.
AGENT_PLANNER_MODE=deterministic
LLM_BASE_URL=
LLM_MODEL_NAME=

GOOGLE_OIDC_ENABLED=false
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_GMAIL_ENABLED=false
GOOGLE_CONTACTS_ENABLED=false
# Required when any Google integration above is enabled: base64 for exactly 32 random bytes.
GOOGLE_PROVIDER_TOKEN_ENCRYPTION_KEY=
