{
	admin off
}

{$AURA_DOMAIN:localhost} {
	encode zstd gzip

	@api path /api/* /health /ready
	handle @api {
		reverse_proxy gateway:4000 {
			transport http {
				read_timeout 310s
				write_timeout 310s
			}
		}
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}
